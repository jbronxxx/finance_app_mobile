#!/bin/sh

# Stash unstaged changes before running tests
git stash -q --keep-index

# Check if fvm is available, otherwise fallback to plain dart/flutter
DART_CMD="fvm dart"
FLUTTER_CMD="fvm flutter"

if ! command -v fvm >/dev/null 2>&1; then
  DART_CMD="dart"
  FLUTTER_CMD="flutter"
fi

# Run formatter
echo "Running $DART_CMD format..."
$DART_CMD format --output=none --set-exit-if-changed .
FORMAT_EXIT_CODE=$?

if [ $FORMAT_EXIT_CODE -ne 0 ]; then
  echo "Error: Code is not formatted properly. Run 'dart format .' to fix it."
  git stash pop -q
  exit 1
fi

# Run analyzer
echo "Running $FLUTTER_CMD analyze..."
$FLUTTER_CMD analyze
ANALYZE_EXIT_CODE=$?

if [ $ANALYZE_EXIT_CODE -ne 0 ]; then
  echo "Error: Code analyzer found issues. Fix them before committing."
  git stash pop -q
  exit 1
fi

# Run tests
echo "Running $FLUTTER_CMD test..."
$FLUTTER_CMD test
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo "Error: Unit tests failed. Fix them before committing."
  git stash pop -q
  exit 1
fi

# Restore unstaged changes
git stash pop -q

exit 0
