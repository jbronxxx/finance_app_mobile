# Скопируйте этот файл в .env и заполните значениями для вашего окружения.
# .env в git не попадает (см. .gitignore) — там могут быть реальные адреса/ключи.

# Базовый URL FastAPI-бэкенда.
# Android-эмулятор:  http://10.0.2.2:8000/api/v1
# iOS-симулятор:      http://127.0.0.1:8000/api/v1
# Реальное устройство: IP-адрес машины с бэкендом в локальной сети
# Продакшен:          https://api.your-domain.com/api/v1
API_BASE_URL=http://10.0.2.2:8000/api/v1

# URL окружений dev и prod (выбор окружения — через Debug-меню, в release всегда prod).
DEV_API_BASE_URL=https://dev.api.example.com/api/v1
PROD_API_BASE_URL=https://api.example.com/api/v1
